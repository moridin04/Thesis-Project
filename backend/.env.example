# "production" disables /docs and enables trusted-host middleware.
APP_ENV=development
# Title shown in the OpenAPI docs.
APP_NAME=AGOS Manila API
# SQLAlchemy connection string for the accounts/audit database.
DATABASE_URL=sqlite:///./agos.db
# Required. Secret for signing access tokens; use a long random string.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
# Required. Secret for signing refresh tokens; must differ from JWT_ACCESS_SECRET.
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token (cookie) lifetime in days.
REFRESH_TOKEN_EXPIRE_DAYS=7
# Comma-separated list of origins allowed by CORS.
FRONTEND_ORIGINS=http://localhost:5173
# Set to true when serving over HTTPS so the refresh cookie is Secure.
COOKIE_SECURE=false
# SameSite policy for the refresh cookie: lax, strict, or none.
COOKIE_SAMESITE=lax
# Optional cookie domain; leave blank for the current host.
COOKIE_DOMAIN=
# Optional. Username for scripts/create_admin.py; prompted if blank.
ADMIN_BOOTSTRAP_USERNAME=
# Optional. Full name for scripts/create_admin.py; defaults to "System Administrator".
ADMIN_BOOTSTRAP_NAME=
# Optional. Password for scripts/create_admin.py (min 12 chars); prompted if blank. Never commit a real value.
ADMIN_BOOTSTRAP_PASSWORD=
